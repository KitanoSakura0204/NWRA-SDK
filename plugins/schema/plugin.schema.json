{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nowork.example/schema/plugin-1.1.schema.json",
  "title": "NoWork plugin manifest (plugin.json), standard 1.1",
  "description": "Mirrors Backend internal/modules/plugins/manifest.go and internal/modules/pluginmarket/pluginstd (the host checks more: extension points against its registry, handler / capability pairing, file references). Every v1 manifest is a valid 1.1 manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "author", "kind"],
  "properties": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,4}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "$ref": "#/$defs/semver" },
    "author": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 512 },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "license": { "type": "string", "maxLength": 64 },
    "kind": { "enum": ["declarative", "wasm", "external"] },
    "scope": { "enum": ["global", "server"] },
    "locales": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 64 },
          "description": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permission" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
    "settings": { "type": "object", "description": "JSON-schema subset, see MANIFEST.md section 4" },
    "points": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/pointUse" } },
    "fields": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/field" } },
    "links": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/link" } },
    "ui": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/slot" } },
    "jobs": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/job" } },
    "gmActions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/gmAction" } },
    "claims": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/claim" } },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowHosts"],
      "properties": {
        "allowHosts": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" } }
      }
    },
    "wasm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": { "$ref": "#/$defs/packagePath", "pattern": "\\.wasm$" },
        "memoryMb": { "type": "integer", "minimum": 0, "maximum": 512 },
        "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": { "endpoint": { "type": "string", "maxLength": 512, "pattern": "^https?://" } }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "description": "Host compatibility (standard 1.1). nowork: a range over the host plugin API version (1.1.0 today); abi: the wasm host ABI version (1). Absent = any 1.x host, ABI 1.",
      "properties": {
        "nowork": { "$ref": "#/$defs/semverRange" },
        "abi": { "type": "integer", "minimum": 0, "maximum": 1, "description": "0 or absent = ABI 1" }
      }
    },
    "icon": { "$ref": "#/$defs/imagePath", "description": "png or webp in the package, at most 256 KiB; 256x256 recommended" },
    "screenshots": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/screenshot" } },
    "categories": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/category" } },
    "keywords": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\s,][^,]*[^\\s,]$|^[^\\s,]$" } },
    "changelog": { "$ref": "#/$defs/longText", "description": "What changed in this version, per UI language" },
    "repository": { "$ref": "#/$defs/httpsUrl" },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "email": { "type": "string", "maxLength": 128, "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
      }
    }
  },
  "$defs": {
    "lang": { "enum": ["zh_CN", "zh_TW", "en", "ja"] },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,32})?$" },
    "semverRange": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^ *(\\*|(>=|<=|>|<|=|\\^|~)?(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,32})?)?)?)( +(\\*|(>=|<=|>|<|=|\\^|~)?(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,32})?)?)?))*( *\\|\\| *(\\*|(>=|<=|>|<|=|\\^|~)?(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,32})?)?)?)( +(\\*|(>=|<=|>|<|=|\\^|~)?(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,32})?)?)?))*)* *$"
    },
    "httpsUrl": { "type": "string", "maxLength": 512, "pattern": "^https://[^/@\\s]+(/\\S*)?$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "export": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "packagePath": { "type": "string", "maxLength": 200, "pattern": "^[^/.\\\\:\\x00][^/\\\\:\\x00]*(/[^/.\\\\:\\x00][^/\\\\:\\x00]*)*$" },
    "imagePath": { "$ref": "#/$defs/packagePath", "pattern": "\\.(png|webp)$" },
    "permission": { "enum": ["user.profile", "user.contact", "user.security", "server.info"] },
    "capability": { "enum": ["log", "kv", "ui", "jobs", "server.read", "user.read", "fields", "notify", "http", "gm.actions", "token.claims", "server.whitelist"] },
    "category": { "enum": ["account", "security", "game", "server", "community", "notification", "integration", "analytics", "appearance", "developer", "other"] },
    "text": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": { "type": "string", "maxLength": 128 }
    },
    "longText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": { "type": "string", "maxLength": 2000 }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/packagePath", "pattern": "\\.(png|webp|jpg|jpeg)$" },
        "caption": { "$ref": "#/$defs/text" }
      }
    },
    "pointUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point"],
      "properties": {
        "point": { "type": "string", "minLength": 1, "maxLength": 64 },
        "handler": { "type": "string" },
        "url": { "type": "string", "maxLength": 512 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "enum": ["string", "number", "boolean", "select"] },
        "label": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": { "type": "object", "additionalProperties": false, "required": ["value", "label"],
            "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 64 }, "label": { "$ref": "#/$defs/text" } } }
        },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "userVisible": { "type": "boolean" },
        "userEditable": { "type": "boolean" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "title", "url"],
      "properties": {
        "area": { "enum": ["home", "admin"] },
        "title": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "entry"],
      "properties": {
        "slot": { "enum": ["admin.page", "admin.dashboard", "admin.user.detail", "home.page", "home.overview", "home.profile"] },
        "title": { "$ref": "#/$defs/text" },
        "entry": { "$ref": "#/$defs/packagePath", "pattern": "\\.[hH][tT][mM][lL]$" },
        "height": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "handler": { "$ref": "#/$defs/export" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "every"],
      "properties": {
        "name": { "$ref": "#/$defs/key" },
        "every": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$", "description": "Go duration, 5m to 168h" },
        "handler": { "$ref": "#/$defs/export" }
      }
    },
    "gmAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "handler": { "$ref": "#/$defs/export" },
        "danger": { "enum": ["", "normal", "confirm", "critical"] },
        "params": {
          "type": "array", "maxItems": 20,
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "type"],
            "properties": { "name": { "$ref": "#/$defs/key" }, "type": { "enum": ["string", "number", "boolean", "player"] },
              "required": { "type": "boolean" }, "label": { "$ref": "#/$defs/text" } } }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "enum": ["string", "number", "boolean", "object"] },
        "description": { "$ref": "#/$defs/text" }
      }
    }
  }
}
