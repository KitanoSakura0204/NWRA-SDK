{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nowork.example/schema/index-1.1.schema.json",
  "title": "NoWork plugin market index (index.json), standard 1.1",
  "description": "Written by noworkplugin index and by the pluginmarket module (GET /api/market/index.json); read by Backend internal/modules/plugins/market.go. A 1.0 index (no format field) stays readable: every 1.1 field is optional.",
  "type": "object",
  "required": [
    "name",
    "plugins"
  ],
  "properties": {
    "format": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 64
    },
    "url": {
      "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/httpsUrl",
      "description": "the market's own site"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "$ref": "#/$defs/publisher"
    },
    "revokedKeys": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/revokedKey"
      }
    },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "assetUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "absolute https URL or relative to the index"
    },
    "publisher": {
      "type": "object",
      "required": [
        "keyId",
        "name"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/keyId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/httpsUrl"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "description": "standard base64 of the 32-byte ed25519 key; informational, trust comes from the admin setting"
        },
        "keys": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "keyId",
              "publicKey"
            ],
            "properties": {
              "keyId": {
                "$ref": "#/$defs/keyId"
              },
              "publicKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{43}=$"
              }
            }
          },
          "description": "every key that signed a listed version and is not revoked"
        }
      }
    },
    "revokedKey": {
      "type": "object",
      "required": [
        "keyId"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/keyId"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "screenshot": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/assetUrl"
        },
        "caption": {
          "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/text"
        }
      }
    },
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "versions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,4}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "declarative",
            "wasm",
            "external"
          ]
        },
        "scope": {
          "enum": [
            "global",
            "server"
          ]
        },
        "homepage": {
          "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/httpsUrl"
        },
        "repository": {
          "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/httpsUrl"
        },
        "support": {
          "type": "object",
          "properties": {
            "url": {
              "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/httpsUrl"
            },
            "email": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "locales": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "icon": {
          "$ref": "#/$defs/assetUrl"
        },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/screenshot"
          }
        },
        "categories": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/category"
          }
        },
        "keywords": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        },
        "featured": {
          "type": "boolean"
        },
        "downloads": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "version",
        "url",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,32})?$"
        },
        "url": {
          "$ref": "#/$defs/assetUrl"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "keyId": {
          "$ref": "#/$defs/keyId"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changelog": {
          "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/longText"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/permission"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/capability"
          }
        },
        "engines": {
          "type": "object",
          "properties": {
            "nowork": {
              "$ref": "https://nowork.example/schema/plugin-1.1.schema.json#/$defs/semverRange"
            },
            "abi": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "yanked": {
          "type": "boolean"
        },
        "yankedReason": {
          "type": "string",
          "maxLength": 256
        }
      }
    }
  }
}
