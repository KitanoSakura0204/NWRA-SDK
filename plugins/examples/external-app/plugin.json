{
  "id": "com.example.externalapp",
  "name": "External app example",
  "version": "1.0.0",
  "author": "Lounge examples",
  "description": "An HTTP service that counts sign-ins through the plugin API and adds a greet GM action.",
  "kind": "external",
  "permissions": ["user.profile"],
  "capabilities": ["kv", "gm.actions"],
  "points": [{ "point": "user.login" }],
  "gmActions": [
    {
      "key": "greet",
      "title": { "en": "Greet a player", "zh_CN": "问候玩家" },
      "params": [{ "name": "player", "type": "player", "required": true, "label": { "en": "Player", "zh_CN": "玩家" } }]
    }
  ],
  "external": { "endpoint": "https://plugins.example.com/lounge" }
}
