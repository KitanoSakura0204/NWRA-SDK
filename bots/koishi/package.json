{
  "name": "koishi-plugin-lounge",
  "version": "0.1.0",
  "description": "Lounge Account bind/unbind/me and command bridge for Koishi v4 (works on any Koishi adapter)",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": ["lib", "README.md"],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "koishi": {
    "description": {
      "zh": "休息室账号绑定、查询，以及聊天指令转发到站点指令注册表",
      "en": "Lounge Account binding, lookup, and a chat command bridge to the site's command registry"
    },
    "service": {
      "required": [],
      "optional": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx ./tests/*.test.ts"
  },
  "peerDependencies": {
    "koishi": "^4.17.0"
  },
  "dependencies": {
    "@lounge/bot-client": "file:../ts-client"
  },
  "devDependencies": {
    "koishi": "4.17.9",
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "@types/node": "20.17.6"
  },
  "license": "UNLICENSED"
}
